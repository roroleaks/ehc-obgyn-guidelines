{
  "name": "ehc-obgyn-guidelines",
  "version": "1.0.0",
  "description": "EHC Obstetric & Gynecology Guidelines Search - Instant keyword/tag search for Egyptian Health Council clinical guidelines",
  "private": true,
  "scripts": {
    "dev": "npx serve . -p 3000",
    "start": "npx serve . -p 3000",
    "deploy": "vercel --prod",
    "test": "node --check app.js && node tests/run-all.js",
    "test:syntax": "node --check app.js",
    "test:harnesses": "node tests/run-all.js"
  },
  "keywords": [
    "ehc",
    "egyptian-health-council",
    "obstetrics",
    "gynecology",
    "clinical-guidelines",
    "medical-reference"
  ],
  "author": "Dr. Raouf Roshdy",
  "license": "MIT",
  "devDependencies": {
    "serve": "^14.2.0",
    "vercel": "^32.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}